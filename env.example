# Public browser-safe Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY

# Server/worker secrets only. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=SET_ONLY_IN_TRUSTED_SERVER_OR_WORKER_SECRET_STORE
OPENAI_API_KEY=SET_ONLY_IN_WORKER_SECRET_STORE
OPENAI_MODEL=gpt-4.1-mini

# Discovery worker
WORKER_USER_AGENT=AventIQOpportunityBot/1.0 (contact: admin@example.org)
WORKER_REQUEST_TIMEOUT=20
WORKER_MIN_CONFIDENCE=0.95
LOG_LEVEL=INFO
